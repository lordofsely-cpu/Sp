name: Build Sely APK

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    name: Build Sely Android APK
    runs-on: ubuntu-24.04

    steps:

      # =========================
      # 1. Checkout repository
      # =========================
      - name: Checkout Sely repository
        uses: actions/checkout@v4

      # =========================
      # 2. Java 17
      # =========================
      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      # =========================
      # 3. Use GitHub's Android SDK
      # =========================
      - name: Configure Android SDK
        shell: bash
        run: |
          set -e

          SDK_ROOT="${ANDROID_HOME:-/usr/local/lib/android/sdk}"

          echo "Android SDK: $SDK_ROOT"

          if [ ! -d "$SDK_ROOT" ]; then
            echo "::error::Android SDK directory was not found."
            exit 1
          fi

          echo "ANDROID_HOME=$SDK_ROOT" >> "$GITHUB_ENV"
          echo "ANDROID_SDK_ROOT=$SDK_ROOT" >> "$GITHUB_ENV"

          echo "$SDK_ROOT/platform-tools" >> "$GITHUB_PATH"
          echo "$SDK_ROOT/cmdline-tools/latest/bin" >> "$GITHUB_PATH"

          SDKMANAGER="$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager"

          if [ ! -x "$SDKMANAGER" ]; then
            SDKMANAGER=$(find "$SDK_ROOT/cmdline-tools" \
              -type f \
              -name sdkmanager \
              2>/dev/null | head -n 1)
          fi

          if [ -z "$SDKMANAGER" ]; then
            echo "::error::sdkmanager was not found."
            find "$SDK_ROOT" -maxdepth 4 -type f -name sdkmanager 2>/dev/null || true
            exit 1
          fi

          echo "Using sdkmanager: $SDKMANAGER"

          yes | "$SDKMANAGER" --licenses >/dev/null || true

          "$SDKMANAGER" \
            "platform-tools" \
            "platforms;android-34" \
            "build-tools;34.0.0"

          echo "Android SDK is ready."

      # =========================
      # 4. Find Sely project
      # =========================
      - name: Locate Sely project
        shell: bash
        run: |
          set -e

          if [ -f "settings.gradle" ] && [ -f "app/build.gradle" ]; then
            echo "Sely project found in repository root."
            echo "PROJECT_DIR=." >> "$GITHUB_ENV"
            exit 0
          fi

          ZIP_FILE=""

          if [ -f "SelyApp-updated.zip" ]; then
            ZIP_FILE="SelyApp-updated.zip"
          else
            ZIP_FILE=$(find . -maxdepth 1 -type f -iname "*.zip" | head -n 1)
          fi

          if [ -z "$ZIP_FILE" ]; then
            echo "::error::Sely Android project or ZIP was not found."
            ls -lah
            exit 1
          fi

          echo "Found Sely ZIP: $ZIP_FILE"

          rm -rf extracted
          mkdir -p extracted

          unzip -q -o "$ZIP_FILE" -d extracted

          PROJECT_DIR=$(find extracted \
            -type f \
            -name "settings.gradle" \
            -exec dirname {} \; | head -n 1)

          if [ -z "$PROJECT_DIR" ]; then
            echo "::error::settings.gradle was not found."
            find extracted -type f | sort
            exit 1
          fi

          echo "Sely project located at: $PROJECT_DIR"
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"

      # =========================
      # 5. Enable AndroidX
      # =========================
      - name: Configure AndroidX
        working-directory: ${{ env.PROJECT_DIR }}
        shell: bash
        run: |
          touch gradle.properties

          grep -qxF 'android.useAndroidX=true' gradle.properties || \
            echo 'android.useAndroidX=true' >> gradle.properties

          grep -qxF 'android.enableJetifier=true' gradle.properties || \
            echo 'android.enableJetifier=true' >> gradle.properties

          echo "AndroidX enabled."

      # =========================
      # 6. Gradle 8.4
      # =========================
      - name: Set up Gradle 8.4
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.4'

      # =========================
      # 7. Build Sely
      # =========================
      - name: Build Sely Debug APK
        working-directory: ${{ env.PROJECT_DIR }}
        shell: bash
        run: |
          set -e

          echo "======================================"
          echo "BUILDING SELy ANDROID APK"
          echo "======================================"

          gradle assembleDebug \
            --stacktrace \
            --no-daemon

      # =========================
      # 8. Find APK
      # =========================
      - name: Verify Sely APK
        shell: bash
        run: |
          set -e

          APK=$(find "${PROJECT_DIR}" \
            -type f \
            -name "app-debug.apk" \
            | head -n 1)

          if [ -z "$APK" ]; then
            echo "::error::Sely APK was not created."

            echo "Searching for APK files:"
            find "${PROJECT_DIR}" \
              -type f \
              -name "*.apk" \
              -print || true

            exit 1
          fi

          echo "======================================"
          echo "SELy APK CREATED SUCCESSFULLY"
          echo "======================================"
          ls -lh "$APK"

          echo "APK_PATH=$APK" >> "$GITHUB_ENV"

      # =========================
      # 9. Upload APK
      # =========================
      - name: Upload Sely APK
        uses: actions/upload-artifact@v4
        with:
          name: Sely-Redesign-APK
          path: ${{ env.APK_PATH }}
          if-no-files-found: error

      # =========================
      # 10. GitHub Release
      # =========================
      - name: Create Sely Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: sely-redesign-${{ github.run_number }}
          name: Sely Redesign Build ${{ github.run_number }}
          files: ${{ env.APK_PATH }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
